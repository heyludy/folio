      },
      "text": {
        "en": {
          "title": "Eunnyeong Heo",
          "college": "Seoul National University",
          "department": "Department of Energy Resources Engineering",
          "position": "Professor",
          "body": "Eunnyeong Heo is a professor at Seoul National University. He studies energy and resource markets, the economic value of technologies and environmental assets, and energy policy. His work brings economic analysis to decisions about energy supply, investment and technological change."
        },
        "ko": {
          "title": "허은녕",
          "college": "서울대학교",
          "department": "에너지자원공학과",
          "position": "교수",
          "body": "허은녕은 서울대학교 에너지자원공학과 교수로, 에너지·자원시장과 기술·환경자산의 가치평가, 에너지정책을 연구한다. 에너지 공급과 투자, 기술 변화에 관한 의사결정을 경제학적으로 분석한다."
        }
      },
      "provenance": {
        "en": {
          "section": {
            "source": "https://temep.snu.ac.kr/en/about/faculty/professor?mode=view&profidx=9",
            "checked": "2026-09-16"
          }
        },

      "text": {
        "en": {
          "title": "Research interests",
          "topic1": "Energy & resource markets",
          "text1": "Energy demand, investment and market structure, with a focus on international energy and mineral markets.",
          "topic2": "Technology, environment & policy",
          "text2": "Technology valuation, renewable energy, energy security and ESG, informed by economic modeling.",
          "topicentry-import-44bb8184": "Energy and resource markets",
          "textentry-import-44bb8184": "Market prices, industrial structure and energy security.",
          "topicentry-import-5c6d0507": "Environmental economics",
          "textentry-import-5c6d0507": "Economic assessment of emissions reduction and recycling policy.",
          "topicentry-import-aa8ee7b4": "Technology and industrial economics",
          "textentry-import-aa8ee7b4": "Technology adoption, R&D evaluation and investment decisions."
        },
        "ko": {
          "title": "연구 분야",
          "topic1": "에너지·자원시장",
          "text1": "국제시장 가격, 산업구조, 에너지안보를 분석한다.",
          "topic2": "기술·환경·정책",
          "text2": "경제 모형을 활용해 기술의 가치, 재생에너지, 에너지 안보와 ESG를 연구합니다.",
          "topicentry-import-67a904a2": "환경경제·경영",
          "textentry-import-67a904a2": "온실가스 감축과 자원 재활용 정책의 경제적 효과를 평가한다.",
          "topicentry-import-35bddf02": "기술·산업경제",
          "textentry-import-35bddf02": "기술 도입, 연구개발 평가와 투자 의사결정을 다룬다."
        }
      },

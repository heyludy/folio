{
  "name": "faculty-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vite build --ssr src/export.jsx --outDir .test-build && node --test scripts/*.test.mjs",
    "test:worker": "vitest run",
    "publisher:dev": "wrangler dev --port 8787",
    "publisher:check": "wrangler deploy --dry-run",
    "publisher:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.10",
    "@msw/cloudflare": "^0.0.1",
    "fake-indexeddb": "^6.2.5",
    "msw": "^2.15.0",
    "vite": "8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
